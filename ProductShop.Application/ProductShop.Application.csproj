<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<!-- Suppress NuGet package vulnerability warnings -->
		<NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
	</PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProductShop.Domain\ProductShop.Domain.csproj" />
    <ProjectReference Include="..\ProductShop.Infrastructure\ProductShop.Infrastructure.csproj" />
    <ProjectReference Include="..\ProductShop.Payments\ProductShop.Payments.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
  </ItemGroup>

</Project>
