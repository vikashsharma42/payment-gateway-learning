<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<!-- Suppress NuGet package vulnerability warnings -->
		<NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <!-- Same id as DineBook.API, so both projects share the Cashfree secrets -->
    <UserSecretsId>6f1c2b7e-3d4a-4e8f-9b2a-7c5d1e0f8a31</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DineBook.Application\DineBook.Application.csproj" />
    <ProjectReference Include="..\DineBook.Infrastructure\DineBook.Infrastructure.csproj" />
    <ProjectReference Include="..\DineBook.Common\DineBook.Common.csproj" />
  </ItemGroup>

</Project>
