@page
@model IndexModel
@{
    ViewData["Title"] = "Restaurants";
}

<section class="hero mb-4">
    <h1 class="display-6">Book a table</h1>
    <p class="lead mb-0">Pick a restaurant and a time. Your booking code arrives straight away.</p>
</section>

@if (Model.Restaurants.Count == 0)
{
    <div class="card p-4 text-center text-muted">
        No restaurants are open for booking right now.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var restaurant in Model.Restaurants)
        {
            <div class="col">
                <article class="card restaurant-card h-100 shadow-sm">
                    <div class="restaurant-cover position-relative">
                        <span class="initial" aria-hidden="true">@restaurant.Name.Substring(0, 1)</span>
                        <span class="tag">@restaurant.Tables.Count tables</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 mb-1">@restaurant.Name</h2>
                        <p class="small text-muted mb-3">@restaurant.Address.Street, @restaurant.Address.City</p>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="meta-chip">🕐 @restaurant.OpensAt.ToString("HH:mm") – @restaurant.ClosesAt.ToString("HH:mm")</span>
                        </div>

                        <a class="btn btn-brand mt-auto" asp-page="/Restaurants/Book" asp-route-id="@restaurant.Id">
                            Book a table<span class="visually-hidden">: @restaurant.Name</span>
                        </a>
                    </div>
                </article>
            </div>
        }
    </div>
}
