@page
@model DashboardModel
@{
    ViewData["Title"] = "My dashboard";
}

<div class="page-hero mb-4">
    <h1 class="h2 mb-1">Hello, @Model.Profile.FirstName</h1>
    <p class="text-muted mb-0">Your bookings, food orders and payments in one place.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card card-body shadow-sm h-100">
            <div class="small text-muted">Upcoming bookings</div>
            <div class="fs-2 fw-semibold">@Model.UpcomingBookings.Count</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-body shadow-sm h-100">
            <div class="small text-muted">Orders waiting for payment</div>
            <div class="fs-2 fw-semibold">@Model.UnpaidOrderCount</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-body shadow-sm h-100">
            <div class="small text-muted">Account</div>
            <div class="fw-semibold">@Model.Profile.Email</div>
            <a class="small" asp-page="/Customer/Profile">Edit profile</a>
        </div>
    </div>
</div>

<section class="mb-4" aria-labelledby="next-heading">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 id="next-heading" class="h5 mb-0">Next bookings</h2>
        <a asp-page="/Customer/Reservations">All bookings</a>
    </div>
    @if (Model.UpcomingBookings.Count == 0)
    {
        <p class="text-muted">You have no upcoming bookings. Open a restaurant's link to book a table.</p>
    }
    else
    {
        <ul class="list-group shadow-sm">
            @foreach (var booking in Model.UpcomingBookings)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                        <strong>@booking.Restaurant.Name</strong>
                        <span class="text-muted">· @booking.StartsAt.ToString("ddd, dd MMM") at @booking.StartsAt.ToString("HH:mm") · @booking.Guests guest(s)</span>
                    </span>
                    <a class="btn btn-sm btn-outline-primary" asp-page="/Reservations/Details" asp-route-slug="@booking.Restaurant.Slug" asp-route-code="@booking.Code">View</a>
                </li>
            }
        </ul>
    }
</section>

<section aria-labelledby="orders-heading">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 id="orders-heading" class="h5 mb-0">Recent orders</h2>
    </div>
    @if (Model.RecentOrders.Count == 0)
    {
        <p class="text-muted">No food orders yet.</p>
    }
    else
    {
        <ul class="list-group shadow-sm">
            @foreach (var order in Model.RecentOrders)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><code>@order.OrderNo</code> · @order.Restaurant.Name</span>
                    <span class="badge text-bg-secondary">@(order.IsPaid ? "Paid" : order.Status.ToString())</span>
                </li>
            }
        </ul>
    }
</section>
