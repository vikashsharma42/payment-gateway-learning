@page
@model OrdersModel
@{
    ViewData["Title"] = "My orders";
}

<h1 class="h2 mb-4">My orders</h1>

@if (Model.Orders.Count == 0)
{
    <p class="text-muted">You have not placed any food orders yet. Pre-order from a booking's page.</p>
}
else
{
    @foreach (var order in Model.Orders)
    {
        <section class="card shadow-sm mb-3" aria-label="Order @order.OrderNo">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <div>
                        <strong>Order <code>@order.OrderNo</code></strong>
                        <span class="text-muted">· @order.Restaurant.Name</span>
                    </div>
                    <div>
                        <span class="badge text-bg-light border">@order.Status</span>
                        <span class="badge @(order.IsPaid ? "text-bg-success" : "text-bg-warning")">@(order.IsPaid ? "Paid" : "Unpaid")</span>
                    </div>
                </div>

                <ul class="list-unstyled mb-2">
                    @foreach (var line in order.Items)
                    {
                        <li class="d-flex justify-content-between small">
                            <span>@line.Quantity × @line.ItemName</span>
                            <span>@DineBook.Web.Helpers.Money.Inr(line.LineTotal().Amount)</span>
                        </li>
                    }
                </ul>

                <div class="d-flex justify-content-between align-items-center">
                    <strong>Total @DineBook.Web.Helpers.Money.Inr(order.BillFor(order.Restaurant).Total.Amount)</strong>
                    <a class="btn btn-sm btn-outline-primary" asp-page="/Reservations/Details" asp-route-slug="@order.Restaurant.Slug" asp-route-code="@order.Reservation.Code">Open booking</a>
                </div>
            </div>
        </section>
    }
}
