@page
@model PaymentsModel
@{
    ViewData["Title"] = "My payments";
}

<div class="page-hero mb-4">
    <h1 class="h2 mb-1">Payments and refunds</h1>
    <p class="text-muted mb-0">Food orders and booking deposits, with any refunds.</p>
</div>

@if (Model.Payments.Count == 0)
{
    <div class="empty-state">
        <p class="empty-state-icon" aria-hidden="true">💳</p>
        <h2 class="h5 mb-1">No payments yet</h2>
        <p class="text-muted mb-0">Payments for food orders and booking deposits appear here.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle bg-white shadow-sm">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Restaurant</th>
                    <th scope="col">Order</th>
                    <th scope="col" class="text-end">Amount</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model.Payments)
                {
                    <tr>
                        <td>@payment.CreatedDateTime.LocalDateTime.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@(payment.Order?.Restaurant.Name ?? "Booking deposit")</td>
                        <td><code>@(payment.Order?.OrderNo ?? "Deposit")</code></td>
                        <td class="text-end">@DineBook.Web.Helpers.Money.Inr(payment.Amount.Amount)</td>
                        <td>
                            <span class="badge text-bg-light border">@payment.Status</span>
                            @if (!string.IsNullOrEmpty(payment.RefundId))
                            {
                                <span class="small text-muted ms-1">Refund @payment.RefundId</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
