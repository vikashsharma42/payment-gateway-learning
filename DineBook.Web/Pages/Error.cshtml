@page "{statusCode}"
@model ErrorModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.ErrorMessage;
}

<div class="d-flex flex-column flex-root">
    <div class="d-flex flex-row-fluid flex-column bgi-size-cover bgi-position-center bgi-no-repeat p-10 p-sm-30" style="background-image: url(/images/error-bg.jpg);">
        <h1 class="font-weight-boldest text-dark-75 mt-15" style="font-size: 10rem">@Model.ErrorStatusCode</h1>
        <p class="font-size-h3 text-muted font-weight-normal">
            @Model.ErrorMessage
        </p>
    </div>
</div>