@page "/Error/{statusCode:int}"
@model ErrorModel
@{
    ViewData["Title"] = Model.ErrorMessage;
}

<section class="page-hero text-center py-5 px-3" aria-labelledby="error-title">
    <p class="error-code mb-2" aria-hidden="true">@Model.ErrorStatusCode</p>
    <h1 id="error-title" class="h3 mb-2">@Model.ErrorMessage</h1>
    <p class="text-muted mx-auto mb-4" style="max-width: 32rem;">@Model.ErrorDescription</p>
    <a asp-page="/Directory" class="btn btn-brand px-4">Back to the home page</a>
</section>
