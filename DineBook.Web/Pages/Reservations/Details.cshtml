@page
@model DetailsModel
@{
    ViewData["Title"] = "Your booking";

    var badge = Model.Reservation?.Status switch
    {
        ReservationStatus.Confirmed => "text-bg-success",
        ReservationStatus.Seated => "text-bg-primary",
        ReservationStatus.Completed => "text-bg-secondary",
        _ => "text-bg-danger"
    };
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-page="/Bookings/Index">My bookings</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(Model.Restaurant?.Name ?? "Booking")</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="h2 mb-0">@(Model.Restaurant?.Name ?? "Your booking")</h1>
    <span class="badge @badge fs-6">@Model.Reservation.Status</span>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Booking code</dt>
                    <dd class="col-7"><code class="fs-5">@Model.Reservation.Code</code></dd>

                    <dt class="col-5">When</dt>
                    <dd class="col-7">@Model.Reservation.StartsAt.ToString("ddd, dd MMM yyyy") at @Model.Reservation.StartsAt.ToString("HH:mm")</dd>

                    <dt class="col-5">Guests</dt>
                    <dd class="col-7">@Model.Reservation.Guests</dd>

                    <dt class="col-5">Booked under</dt>
                    <dd class="col-7">@Model.Reservation.CustomerName</dd>
                </dl>
            </div>
        </div>

        @if (!Model.IsOwner)
        {
            <form method="post" asp-page-handler="Unlock" class="card card-body shadow-sm" data-submit-once>
                <input type="hidden" name="Code" value="@Model.Code" />
                <h2 class="h5">Open this booking</h2>
                <p class="text-muted small">Enter the phone number used for this booking. You only need to do this once on this device.</p>
                <div class="d-flex gap-2">
                    <div class="input-group phone-input flex-grow-1">
                        <span class="input-group-text phone-prefix" aria-hidden="true">
                            <img src="~/img/flag-in.svg" alt="" width="24" height="16" /> +91
                        </span>
                        <input name="UnlockPhone" type="tel" class="form-control" placeholder="98765 43210"
                               aria-label="Phone number" autocomplete="tel" inputmode="tel" required />
                    </div>
                    <button type="submit" class="btn btn-brand">Open</button>
                </div>
            </form>
        }
        else if (Model.CanCancel)
        {
            <form method="post" asp-page-handler="Cancel" class="card card-body shadow-sm" data-submit-once>
                <input type="hidden" name="Code" value="@Model.Code" />
                <h2 class="h6">Need to cancel?</h2>
                <p class="text-muted small mb-2">You can cancel this booking any time before your visit.</p>
                <button type="submit" class="btn btn-outline-danger">Cancel booking</button>
            </form>
        }
    </div>

    @if (Model.IsOwner)
    {
        <div class="col-lg-7">
            <section class="card shadow-sm mb-4" aria-labelledby="food-heading">
                <div class="card-body">
                    <h2 id="food-heading" class="h5">Your food</h2>

                    @if (Model.FoodOrders.Count == 0)
                    {
                        <p class="text-muted mb-0">No food ordered for this booking yet.</p>
                    }

                    @foreach (var order in Model.FoodOrders)
                    {
                        <div class="border-top pt-3 mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-muted">Ordered @order.CreatedDateTime.ToLocalTime().ToString("dd MMM, HH:mm")</span>
                                @if (order.IsPaid)
                                {
                                    <span class="badge text-bg-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">To pay</span>
                                }
                            </div>

                            <ul class="list-unstyled mb-2">
                                @foreach (var line in order.Items)
                                {
                                    <li class="d-flex align-items-center gap-3 py-2">
                                        @if (!string.IsNullOrEmpty(line.ImageUrl))
                                        {
                                            <img class="dish-thumb" src="@line.ImageUrl" alt="" loading="lazy" width="56" height="56" />
                                        }
                                        else
                                        {
                                            <span class="dish-thumb dish-thumb--empty" aria-hidden="true">🍽️</span>
                                        }
                                        <span class="flex-grow-1">
                                            <span class="fw-semibold">@line.ItemName</span>
                                            <span class="d-block small text-muted">@line.Quantity × @Money.Inr(line.UnitPrice)</span>
                                        </span>
                                        <span class="fw-semibold">@Money.Inr(line.LineTotal())</span>
                                    </li>
                                }
                            </ul>

                            <div class="d-flex justify-content-between align-items-center">
                                <strong>Total @Money.Inr(order.Total())</strong>
                                @if (!order.IsPaid && Model.CanPay)
                                {
                                    <form method="post" asp-page-handler="PayOrder" data-submit-once>
                                        <input type="hidden" name="Code" value="@Model.Code" />
                                        <button type="submit" name="orderId" value="@order.Id" class="btn btn-brand">
                                            Pay @Money.Inr(order.Total())
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>

            @if (Model.CanOrderFood && Model.MenuGroups.Count > 0)
            {
                <form method="post" asp-page-handler="Order" class="card shadow-sm mb-4" data-submit-once>
                    <div class="card-body">
                        <h2 class="h5">Add food</h2>
                        <p class="text-muted small">Choose how many of each dish you want, then place the order.</p>
                        <input type="hidden" name="Code" value="@Model.Code" />

                        @foreach (var group in Model.MenuGroups)
                        {
                            <h3 class="h6 text-uppercase text-muted mt-3 mb-1">@group.Key</h3>
                            <ul class="list-unstyled mb-0">
                                @foreach (var item in group)
                                {
                                    <li class="d-flex align-items-center gap-3 py-2 border-bottom">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img class="dish-thumb" src="@item.ImageUrl" alt="" loading="lazy" width="56" height="56" />
                                        }
                                        else
                                        {
                                            <span class="dish-thumb dish-thumb--empty" aria-hidden="true">🍽️</span>
                                        }
                                        <span class="flex-grow-1">
                                            <span class="fw-semibold">@item.Name</span>
                                            @if (!string.IsNullOrEmpty(item.Description))
                                            {
                                                <span class="d-block small text-muted">@item.Description</span>
                                            }
                                            <span class="d-block small">@Money.Inr(item.Price)</span>
                                        </span>
                                        <label class="visually-hidden" for="qty_@item.Id">Quantity of @item.Name</label>
                                        <input id="qty_@item.Id" type="number" class="form-control form-control-sm qty-input"
                                               name="qty_@item.Id" min="0" max="20" value="0" />
                                    </li>
                                }
                            </ul>
                        }

                        <button type="submit" class="btn btn-brand w-100 mt-4">Place order</button>
                    </div>
                </form>
            }
        </div>
    }
</div>

<div class="mt-4">
    <a asp-page="/Bookings/Index" class="btn btn-outline-secondary">Back to my bookings</a>
</div>
