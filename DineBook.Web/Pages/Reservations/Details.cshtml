@page "/{slug}/Reservations/{code}"
@model DetailsModel
@{
    ViewData["Title"] = "Your booking";

    var badge = Model.Reservation.Status switch
    {
        DineBook.Domain.Enums.ReservationStatus.Confirmed => "text-bg-success",
        DineBook.Domain.Enums.ReservationStatus.Seated => "text-bg-primary",
        DineBook.Domain.Enums.ReservationStatus.Completed => "text-bg-secondary",
        _ => "text-bg-danger"
    };
    var isConfirmed = Model.Reservation.Status == DineBook.Domain.Enums.ReservationStatus.Confirmed;
}

<h1 class="h2 mb-4">Your booking</h1>

<div class="card shadow-sm" style="max-width: 36rem;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-5">Booking code</dt>
            <dd class="col-7"><code class="fs-5">@Model.Reservation.Code</code></dd>

            <dt class="col-5">Restaurant</dt>
            <dd class="col-7">@(Model.Restaurant?.Name ?? "—")</dd>

            <dt class="col-5">When</dt>
            <dd class="col-7">@Model.Reservation.StartsAt.ToString("ddd, dd MMM yyyy") at @Model.Reservation.StartsAt.ToString("HH:mm")</dd>

            <dt class="col-5">Guests</dt>
            <dd class="col-7">@Model.Reservation.Guests</dd>

            <dt class="col-5">Name</dt>
            <dd class="col-7">@Model.Reservation.CustomerName</dd>

            <dt class="col-5">Status</dt>
            <dd class="col-7"><span class="badge @badge">@Model.Reservation.Status</span></dd>
        </dl>
    </div>
</div>

@if (isConfirmed && Model.CanChange)
{
    <div class="alert alert-light border small mt-4" style="max-width: 36rem;" role="note">
        You can change or cancel this booking until <strong>@Model.Reservation.ChangeDeadline.ToString("ddd dd MMM, HH:mm")</strong>.
        After that time, please call the restaurant for help.
    </div>

    <form method="post" asp-page-handler="Update" class="card shadow-sm mt-3" style="max-width: 36rem;" data-submit-once>
        <div class="visually-hidden" aria-hidden="true"><label>Leave this field empty<input type="text" name="website_url" tabindex="-1" autocomplete="off" /></label></div>
        <div class="card-body">
            <h2 class="h6">Change your booking</h2>
            <p class="small text-muted">Need a different number of guests, or want to add a note for the restaurant? Update it here. To change the date, time or table, cancel and book again.</p>
            <input type="hidden" name="Code" value="@Model.Reservation.Code" />
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label" for="change-phone">Phone number on this booking</label>
                    <input id="change-phone" asp-for="Change.Phone" type="tel" class="form-control" autocomplete="tel" required />
                    <span asp-validation-for="Change.Phone" class="text-danger small"></span>
                </div>
                <div class="col-sm-4">
                    <label class="form-label" for="change-guests">Guests</label>
                    <input id="change-guests" asp-for="Change.Guests" type="number" min="1" max="10" class="form-control" />
                    <span asp-validation-for="Change.Guests" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label" for="change-requests">Special requests (optional)</label>
                    <textarea id="change-requests" asp-for="Change.SpecialRequests" class="form-control" rows="2" maxlength="200" placeholder="e.g. a high chair, allergies or a birthday"></textarea>
                    <span asp-validation-for="Change.SpecialRequests" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <button type="submit" class="btn-brand">Save changes</button>
            </div>
        </div>
    </form>

    <div class="mt-3">
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancel-booking-modal">Cancel booking</button>
    </div>

    <div class="modal fade" id="cancel-booking-modal" tabindex="-1" aria-labelledby="cancel-booking-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-page-handler="Cancel" class="modal-content" data-submit-once>
                <div class="modal-header">
                    <h2 class="h5 modal-title" id="cancel-booking-title">Cancel this booking?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Enter the phone number on this booking to cancel it. Cancelling can't be undone.</p>
                    <input type="hidden" name="Code" value="@Model.Reservation.Code" />
                    <label class="form-label" for="cancel-phone">Phone number on this booking</label>
                    <input id="cancel-phone" name="Input.Phone" type="tel" class="form-control" autocomplete="tel" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Keep booking</button>
                    <button type="submit" class="btn btn-danger">Cancel booking</button>
                </div>
            </form>
        </div>
    </div>
}
else if (isConfirmed)
{
    <div class="alert alert-warning small mt-4" style="max-width: 36rem;" role="note">
        Changes and cancellations close @DineBook.Domain.Entities.ReservationRules.CustomerChangeCutoff.TotalHours hours before your booking starts.
        For any change now, please call the restaurant.
    </div>
}

@if (Model.CanOrderFood && Model.Menu.Count > 0)
{
    <form method="post" asp-page-handler="Order" class="card shadow-sm mt-4" style="max-width: 36rem;" data-submit-once>
        <div class="visually-hidden" aria-hidden="true"><label>Leave this field empty<input type="text" name="website_url" tabindex="-1" autocomplete="off" /></label></div>
        <div class="card-body">
            <h2 class="h5">Pre-order your food</h2>
            <p class="small text-muted">Choose your dishes now and we'll have them ready for you. Enter the phone number on this booking to continue.</p>
            <input type="hidden" name="Code" value="@Model.Reservation.Code" />

            <div class="mb-3">
                <label class="form-label" for="OrderPhone">Phone number on this booking</label>
                <input id="OrderPhone" name="Input.Phone" type="tel" class="form-control" required />
            </div>

            <table class="table align-middle mb-3">
                <tbody>
                    @{ string lastCategory = null; }
                    @foreach (var item in Model.Menu)
                    {
                        if (item.Category != lastCategory)
                        {
                            lastCategory = item.Category;
                            <tr class="table-light">
                                <th colspan="3" scope="colgroup">@item.Category</th>
                            </tr>
                        }
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img class="dish-img" src="@item.ImageUrl" alt="" loading="lazy" style="width:48px;height:48px;flex-basis:48px;" />
                                    }
                                    else
                                    {
                                        <div class="dish-img dish-fallback" aria-hidden="true" style="width:48px;height:48px;flex-basis:48px;">@item.Name.Substring(0, 1).ToUpperInvariant()</div>
                                    }
                                    <div>
                                        <div class="fw-semibold">@item.Name</div>
                                        <div class="small text-muted">@item.Description</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-end">@Money.Inr(item.Price.Amount)</td>
                            <td style="width: 6rem;">
                                <input type="number" class="form-control form-control-sm" name="qty_@item.Id"
                                       min="0" max="20" value="0" aria-label="Quantity of @item.Name" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <button type="submit" class="btn btn-brand w-100">Place order</button>
        </div>
    </form>
}

@if (Model.CanPay)
{
    <form method="post" asp-page-handler="Pay" class="card shadow-sm mt-4" style="max-width: 36rem;" data-submit-once>
        <div class="visually-hidden" aria-hidden="true"><label>Leave this field empty<input type="text" name="website_url" tabindex="-1" autocomplete="off" /></label></div>
        <div class="card-body">
            <h2 class="h6">Pay your bill</h2>
            <p class="small text-muted">Pay for the food you ordered during this visit. Enter the phone number on this booking to see your bill.</p>
            <input type="hidden" name="Code" value="@Model.Reservation.Code" />
            <div class="input-group">
                <input name="Input.Phone" type="tel" class="form-control" placeholder="Phone number" aria-label="Phone number" required />
                <button type="submit" class="btn btn-brand">Show my orders</button>
            </div>
        </div>
    </form>
}

@if (Model.PayableOrders.Count > 0)
{
    <form method="post" asp-page-handler="PayOrder" class="card shadow-sm mt-4" style="max-width: 36rem;" data-submit-once>
        <div class="visually-hidden" aria-hidden="true"><label>Leave this field empty<input type="text" name="website_url" tabindex="-1" autocomplete="off" /></label></div>
        <div class="card-body">
            <h2 class="h6">Choose an order to pay</h2>
            <input type="hidden" name="Code" value="@Model.Reservation.Code" />
            <input type="hidden" name="Input.Phone" value="@Model.Input.Phone" />

            @foreach (var order in Model.PayableOrders)
            {
                <div class="border-top pt-3 mt-3">
                    <p class="small text-muted mb-2">Order <code>@order.OrderNo</code></p>
                    <table class="table table-sm align-middle mb-2">
                        <thead>
                            <tr>
                                <th scope="col">Category</th>
                                <th scope="col">Item</th>
                                <th scope="col" class="text-end">Qty</th>
                                <th scope="col" class="text-end">Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in order.Items)
                            {
                                <tr>
                                    <td class="small text-muted">@line.MenuItem?.Category</td>
                                    <td>@line.ItemName</td>
                                    <td class="text-end">@line.Quantity</td>
                                    <td class="text-end">@Money.Inr(line.LineTotal().Amount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="d-flex justify-content-between align-items-center">
                        <strong>Total @Money.Inr(order.BillFor(Model.Restaurant).Total.Amount)</strong>
                        <button type="submit" name="orderId" value="@order.Id" class="btn btn-brand">Pay this order</button>
                    </div>
                </div>
            }
        </div>
    </form>
}

<div class="d-flex gap-2 mt-4">
    <a asp-page="/Restaurants/Index" asp-route-slug="@Model.Restaurant.Slug" class="btn btn-outline-secondary">Back to @Model.Restaurant.Name</a>
</div>
