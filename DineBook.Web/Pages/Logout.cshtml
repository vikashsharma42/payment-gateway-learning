@page
@model DineBook.Web.Pages.LogoutModel
@{
    ViewData["Title"] = "Sign out";
}

<div class="card shadow-sm mx-auto" style="max-width: 26rem;">
    <div class="card-body p-4 text-center">
        @if (Model.IsSignedIn)
        {
            <h1 class="h4 mb-2">Sign out of DineBook?</h1>
            <p class="text-muted mb-4">You'll need to sign in again to book a table, order food or manage your account.</p>
            <form method="post" class="d-grid gap-2">
                <button type="submit" class="btn btn-brand">Sign out</button>
                @if (Model.CancelPage is not null)
                {
                    <a class="btn btn-outline-secondary" asp-page="@Model.CancelPage" asp-route-slug="@Model.CancelSlug">Stay signed in</a>
                }
            </form>
        }
        else
        {
            <h1 class="h4 mb-2">You are not signed in</h1>
            <p class="text-muted mb-4">You're already signed out, so there's nothing to do here.</p>
            <a class="btn btn-brand" asp-page="/Login">Go to sign in</a>
        }
    </div>
</div>
