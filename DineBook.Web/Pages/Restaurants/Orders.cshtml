@page "/{slug}/Orders"
@model OrdersModel
@{
    ViewData["Title"] = "My orders · " + Model.Restaurant.Name;
}

<div class="page-hero mb-4">
    <h1 class="h2 mb-1">My orders</h1>
    <p class="text-muted mb-0">@Model.Restaurant.Name</p>
</div>

@if (Model.Orders.Count == 0)
{
    <section class="card shadow-sm border-0 text-center p-4 p-md-5" aria-labelledby="empty-orders-title">
        <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
             style="width: 4.5rem; height: 4.5rem; background: #fdf1ea; color: var(--brand);" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 12h16" />
                <path d="M3 12a9 9 0 0 0 18 0" />
                <path d="M9 7.5c0-1.5 1-2.5 3-2.5s3 1 3 2.5" />
            </svg>
        </div>

        <h2 id="empty-orders-title" class="h4 mb-2">No food orders yet</h2>
        <p class="text-muted mx-auto mb-0" style="max-width: 28rem;">
            Food you order at @Model.Restaurant.Name will show up here. Book a table, then add dishes to your pre-order from the booking page.
        </p>

        @if (Model.DefaultLocation is not null)
        {
            <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
                <a class="btn btn-brand btn-lg px-4"
                   asp-page="/Restaurants/Book"
                   asp-route-slug="@Model.Restaurant.Slug"
                   asp-route-locationSlug="@Model.DefaultLocation.Slug">Book a table to order</a>
                <a class="btn btn-outline-secondary btn-lg px-4"
                   asp-page="/Restaurants/Menu"
                   asp-route-slug="@Model.Restaurant.Slug"
                   asp-route-locationSlug="@Model.DefaultLocation.Slug">View menu</a>
            </div>
        }
    </section>
}
else
{
    @foreach (var order in Model.Orders)
    {
        <section class="card shadow-sm mb-3" aria-label="Order @order.OrderNo">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <div>
                        <strong>Order <code>@order.OrderNo</code></strong>
                    </div>
                    <div>
                        <span class="badge text-bg-light border">@order.Status</span>
                        <span class="badge @(order.IsPaid ? "text-bg-success" : "text-bg-warning")">@(order.IsPaid ? "Paid" : "Unpaid")</span>
                    </div>
                </div>

                <ul class="list-unstyled mb-2">
                    @foreach (var line in order.Items)
                    {
                        <li class="d-flex justify-content-between small">
                            <span>@line.Quantity × @line.ItemName</span>
                            <span>@DineBook.Web.Helpers.Money.Inr(line.LineTotal().Amount)</span>
                        </li>
                    }
                </ul>

                <div class="d-flex justify-content-between align-items-center">
                    <strong>Total @DineBook.Web.Helpers.Money.Inr(order.BillFor(Model.Restaurant).Total.Amount)</strong>
                    <a class="btn btn-sm btn-outline-primary"
                       asp-page="/Reservations/Details"
                       asp-route-slug="@Model.Restaurant.Slug"
                       asp-route-locationSlug="@Model.Restaurant.LocationSlugFor(order.Reservation)"
                       asp-route-code="@order.Reservation.Code">Open booking</a>
                </div>
            </div>
        </section>
    }
}