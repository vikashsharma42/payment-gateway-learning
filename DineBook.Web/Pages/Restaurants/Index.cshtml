@page "/{slug}"
@model IndexModel
@{
    ViewData["Title"] = Model.Restaurant?.Name ?? "Restaurant";
}

<div class="page-hero mb-4">
    <h1 class="h2 mb-1">@Model.Restaurant.Name</h1>
    <p class="text-muted mb-0">Table reservations</p>
</div>

<div class="empty-state">
    <p class="empty-state-icon" aria-hidden="true">🍽️</p>
    <h2 class="h5 mb-1">No location is taking bookings right now</h2>
    <p class="text-muted mb-0">Please check back soon.</p>
</div>
