@page "/{slug}/{locationSlug}/book"
@model BookModel
@{
    ViewData["Title"] = Model.Restaurant.Name + " · Book a table";
    var header = new DineBook.Web.Models.RestaurantHeader(Model.Restaurant, Model.SelectedLocation, "book");
    var returnUrl = Url.Page("/Restaurants/Book", new { slug = Model.Restaurant.Slug, locationSlug = Model.SelectedLocation.Slug });
}

<partial name="_RestaurantHeader" model="header" />

<section aria-labelledby="booking-heading">
    <h2 id="booking-heading" class="h5">Book a table at @Model.SelectedLocation.Name</h2>

    @if (!Model.IsSignedIn)
    {
        <div class="card card-body shadow-sm">
            <p class="mb-3">Sign in to book a table at @Model.Restaurant.Name.</p>
            <a class="btn btn-brand" asp-page="/Login" asp-route-slug="@Model.Restaurant.Slug" asp-route-ReturnUrl="@returnUrl">Sign in to book</a>
        </div>
    }
    else
    {
        <form method="get" class="card card-body shadow-sm mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-sm-5">
                    <label class="form-label" for="Date">Date</label>
                    <input id="Date" name="Date" type="date" class="form-control"
                           value="@Model.Date?.ToString("yyyy-MM-dd")" min="@Model.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-sm-4">
                    <label class="form-label" for="Guests">Guests</label>
                    <input id="Guests" name="Guests" type="number" min="1" max="10" class="form-control" value="@Model.Guests" />
                </div>
                <div class="col-sm-3">
                    <button class="btn btn-outline-primary w-100" type="submit">Show times</button>
                </div>
            </div>
        </form>

        @if (Model.Date is not null)
        {
            if (Model.Slots.Count == 0)
            {
                <div class="alert alert-warning" role="status">
                    No tables are free for @Model.Guests guests on this day. Try another date or party size.
                </div>
            }
            else
            {
                <form method="post" data-submit-once class="card card-body shadow-sm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <input type="hidden" name="Date" value="@Model.Date.Value.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="Guests" value="@Model.Guests" />

                    <fieldset class="mb-4">
                        <legend class="h6">Choose a time</legend>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var slot in Model.Slots)
                            {
                                <input type="radio" class="btn-check" name="StartsAt" id="slot-@slot.ToString("HHmm")"
                                       value="@slot.ToString("s")" autocomplete="off" required />
                                <label class="btn btn-outline-primary" for="slot-@slot.ToString("HHmm")">@slot.ToString("HH:mm")</label>
                            }
                        </div>
                        <span asp-validation-for="StartsAt" class="text-danger small"></span>
                    </fieldset>

                    <p class="mb-4">Booking in the name of <strong>@Model.BookingName</strong>. Your phone number and email come from your account.</p>

                    <div class="mb-4">
                        <label asp-for="SpecialRequests" class="form-label"></label>
                        <textarea asp-for="SpecialRequests" class="form-control" rows="2" maxlength="200"></textarea>
                        <span asp-validation-for="SpecialRequests" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-brand btn-lg w-100">Confirm booking</button>
                </form>
            }
        }
    }
</section>
