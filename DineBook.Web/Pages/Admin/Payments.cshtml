@page
@model PaymentsModel
@{
    ViewData["Title"] = "Admin · Payments";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h2 mb-0">Payments and refunds</h1>
    <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary">Dashboard</a>
</div>

@if (Model.Payments.Count == 0)
{
    <div class="card p-4 text-center text-muted">No payments yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle bg-white shadow-sm">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Restaurant</th>
                    <th scope="col">Order</th>
                    <th scope="col">Customer email</th>
                    <th scope="col" class="text-end">Amount</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model.Payments)
                {
                    <tr>
                        <td>@payment.CreatedDateTime.LocalDateTime.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@payment.Order.Restaurant.Name</td>
                        <td><code>@payment.Order.OrderNo</code></td>
                        <td class="small">@payment.CustomerEmail</td>
                        <td class="text-end">@DineBook.Web.Helpers.Money.Inr(payment.Amount.Amount)</td>
                        <td>
                            <span class="badge text-bg-light border">@payment.Status</span>
                            @if (!string.IsNullOrEmpty(payment.RefundId))
                            {
                                <span class="small text-muted ms-1">Refund @payment.RefundId</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
