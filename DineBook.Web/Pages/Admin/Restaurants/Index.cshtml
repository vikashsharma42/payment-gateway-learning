@page "/Admin/Restaurants"
@model IndexModel
@{
    ViewData["Title"] = "Restaurants";
}

<div class="page-hero">
    <h1 class="h2 mb-1">Find a restaurant</h1>
    <p class="text-muted mb-0">Browse any menu without signing in. Sign in to book a table.</p>
</div>

@if (Model.Restaurants.Count == 0)
{
    <p class="text-muted">No restaurants are open for booking yet.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-3 mt-1">
        @foreach (var restaurant in Model.Restaurants)
        {
            <div class="col">
                <section class="card h-100 shadow-sm" aria-labelledby="r-@restaurant.Id">
                    <div class="card-body">
                        <h2 id="r-@restaurant.Id" class="h5 mb-1">
                            <a asp-page="/Restaurants/Index" asp-route-slug="@restaurant.Slug" class="text-decoration-none">@restaurant.Name</a>
                        </h2>
                        <p class="small text-muted mb-2">@restaurant.OpensAt.ToString("h:mm tt") to @restaurant.ClosesAt.ToString("h:mm tt")</p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var location in restaurant.ActiveLocations)
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-page="/Restaurants/Location"
                                   asp-route-slug="@restaurant.Slug"
                                   asp-route-locationSlug="@location.Slug">@location.Name</a>
                            }
                        </div>
                    </div>
                </section>
            </div>
        }
    </div>
}
