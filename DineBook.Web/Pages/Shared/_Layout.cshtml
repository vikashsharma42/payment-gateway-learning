@{
    // Set by AppPageModel and read once per request
    var toastJson = TempData["Toast"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · DineBook</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header py-3">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="brand" asp-page="/Index">DineBook</a>
            <nav class="d-flex align-items-center gap-3">
                <a class="link-light" asp-page="/Index">Restaurants</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="link-light" asp-page="/Admin/Index">Admin</a>
                    }
                    <form method="post" asp-page="/Admin/Logout" class="d-inline">
                        <button type="submit" class="btn btn-link link-light p-0 text-decoration-none">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="link-light" asp-page="/Admin/Login">Sign in</a>
                }
                <span class="secure-badge">Secure checkout</span>
            </nav>
        </div>
    </header>

    <main id="main" class="container py-4 py-md-5">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>© @DateTime.UtcNow.Year DineBook</span>
            <span>Table reservations</span>
        </div>
    </footer>

    <div id="toast-host" class="toast-container position-fixed top-0 end-0 p-3"
         data-toast="@toastJson"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/app.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
