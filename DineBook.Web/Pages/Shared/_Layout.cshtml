@{
    // Set by AppPageModel and read once per request
    var toastJson = TempData["Toast"] as string;

    // Set by the pages after an order or payment is complete (see Details and Payment/Result)
    var celebrate = TempData["Celebrate"] as string == "1";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · DineBook</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enhance.css" asp-append-version="true" />
    <meta name="theme-color" content="#9a3412" />
</head>
<body data-celebrate="@celebrate.ToString().ToLowerInvariant()">
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="nav-progress" class="nav-progress" aria-hidden="true"></div>

    <header class="site-header py-3">
        <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
            <span class="brand">DineBook</span>
            <nav class="d-flex flex-wrap align-items-center gap-3" aria-label="Main">
                <partial name="_RoleNav" />
                <span class="secure-badge">Secure checkout</span>
            </nav>
        </div>
    </header>

    <main id="main" class="container py-4 py-md-5 page-stagger">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>© @DateTime.UtcNow.Year DineBook</span>
            <span>Table reservations</span>
        </div>
    </footer>

    <div id="toast-host" class="toast-container position-fixed top-0 end-0 p-3"
         data-toast="@toastJson"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/app.js" asp-append-version="true" defer></script>
    <script src="~/js/celebrate.js" asp-append-version="true" defer></script>
    <script src="~/js/ux.js" asp-append-version="true" defer></script>
    <script src="~/js/phone-field.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_LogoutModal" />
    }
</body>
</html>
