@{
    // Each role sees only its own links. Access itself is enforced by the folder policies in Startup and by each page.
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var signedIn = User.Identity?.IsAuthenticated == true;

    // The restaurant in the address, or the one remembered from an earlier visit
    var slug = ViewContext.RouteData.Values["slug"] as string
               ?? DineBook.Web.Infrastructure.RestaurantCookie.Recall(Context.Request);

    // A customer counts as signed in here only when their account belongs to the restaurant in the address.
    // The sign-in cookie covers the whole site, so an account from another restaurant is a guest here.
    var accountHere = signedIn
                      && role == "Customer"
                      && slug is not null
                      && string.Equals(User.FindFirst(DineBook.Application.Security.UserClaimsFactory.RestaurantSlugClaim)?.Value, slug, System.StringComparison.OrdinalIgnoreCase);

    var showHome = slug is not null && (!signedIn || role == "Customer");
}

@if (showHome)
{
    <a class="link-light" asp-page="/Restaurants/Index" asp-route-slug="@slug">Home</a>
}

@if (slug is not null && (!signedIn || (role == "Customer" && !accountHere)))
{
    <a class="link-light" asp-page="/Restaurants/Registration" asp-route-slug="@slug">Create account</a>
    <a class="link-light" asp-page="/Restaurants/Login" asp-route-slug="@slug">Sign in</a>
}

@if (signedIn)
{
    switch (role)
    {
        case "Customer":
            if (accountHere)
            {
                <a class="link-light" asp-page="/Restaurants/Orders" asp-route-slug="@slug">Orders</a>
                <a class="link-light" asp-page="/Restaurants/Profile" asp-route-slug="@slug">Profile</a>
            }
            break;

        case "Staff":
            <a class="link-light" asp-page="/Staff/Dashboard">Dashboard</a>
            <a class="link-light" asp-page="/Staff/Reservations">Bookings</a>
            <a class="link-light" asp-page="/Staff/Orders">Orders</a>
            break;

        case "Manager":
            <a class="link-light" asp-page="/Manager/Dashboard">Dashboard</a>
            <a class="link-light" asp-page="/Manager/Restaurant">Restaurant</a>
            <a class="link-light" asp-page="/Manager/Locations">Locations</a>
            <a class="link-light" asp-page="/Manager/Tables">Tables</a>
            <a class="link-light" asp-page="/Manager/Menu">Menu</a>
            <a class="link-light" asp-page="/Manager/Reservations">Bookings</a>
            <a class="link-light" asp-page="/Manager/Orders">Orders</a>
            <a class="link-light" asp-page="/Manager/Restaurant/Charges">Charges</a>
            break;

        case "Admin":
            <a class="link-light" asp-page="/Admin/Dashboard">Dashboard</a>
            <a class="link-light" asp-page="/Admin/Restaurants/Index">Restaurants</a>
            <a class="link-light" asp-page="/Admin/Users/Index">Users</a>
            <a class="link-light" asp-page="/Admin/Payments">Payments</a>
            <a class="link-light" asp-page="/Admin/Monitoring">Security</a>
            break;
    }

    <button type="button" class="btn btn-link link-light p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#logout-modal">Sign out</button>
}
