@model DineBook.Web.Pages.LoginModel

<div class="card shadow-sm" style="max-width: 26rem;">
    <div class="card-body p-4">
        <form method="post" data-submit-once>
            <div class="visually-hidden" aria-hidden="true"><label>Leave this field empty<input type="text" name="website_url" tabindex="-1" autocomplete="off" /></label></div>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            @if (Model.Denied)
            {
                <div class="alert alert-warning" role="alert">This account doesn't have access to that page. Try signing in with a different account.</div>
            }
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-danger" role="alert">@Model.Error</div>
            }

            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" type="email" class="form-control" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-brand w-100">Sign in</button>
        </form>
    </div>
</div>
