@page
@model OrdersModel
@{
    ViewData["Title"] = "Staff · Food orders";
}

<h1 class="h2 mb-1">Food orders</h1>
@if (Model.Workspace is not null)
{
    <p class="text-muted mb-4">@Model.Workspace.Current.Name · newest first</p>
}

@if (Model.Workspace is null)
{
    <div class="card p-4 text-center text-muted">You are not assigned to a restaurant yet.</div>
}
else if (Model.IncomingOrders.TotalCount == 0)
{
    <p class="text-muted">No food orders at this location yet. They'll appear here as guests order.</p>
}
else
{
    @foreach (var order in Model.IncomingOrders.Items)
    {
        <section class="card shadow-sm mb-3" aria-label="Order @order.OrderNo">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <div>
                        <strong><code>@order.OrderNo</code></strong>
                        <span class="text-muted">· Table @order.Reservation?.Table?.Label · @order.Reservation?.CustomerName</span>
                    </div>
                    <div>
                        <span class="badge text-bg-light border">@order.Status</span>
                        <span class="badge @(order.IsPaid ? "text-bg-success" : "text-bg-warning")">@(order.IsPaid ? "Paid" : "Unpaid")</span>
                    </div>
                </div>

                <ul class="list-unstyled mb-3">
                    @foreach (var line in order.Items)
                    {
                        <li class="d-flex justify-content-between small">
                            <span>@line.Quantity × @line.ItemName</span>
                        </li>
                    }
                </ul>

                @if (order.Status == DineBook.Domain.Enums.OrderStatus.Placed)
                {
                    <div class="d-flex gap-2">
                        <form method="post" asp-page-handler="Serve" data-submit-once>
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <input type="hidden" name="Query.Page" value="@Model.Query.Page" />
                            <input type="hidden" name="Query.PageSize" value="@Model.Query.PageSize" />
                            <button class="btn btn-sm btn-brand">Mark served</button>
                        </form>
                        <form method="post" asp-page-handler="Cancel" data-submit-once>
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <input type="hidden" name="Query.Page" value="@Model.Query.Page" />
                            <input type="hidden" name="Query.PageSize" value="@Model.Query.PageSize" />
                            <button class="btn btn-sm btn-outline-danger">Cancel order</button>
                        </form>
                    </div>
                }
            </div>
        </section>
    }
    <partial name="_Pager" model="Model.IncomingOrders" />
}
