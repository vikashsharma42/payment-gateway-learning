@page
@model ReservationsModel
@{
    ViewData["Title"] = "Staff · Bookings";
}

<h1 class="h2 mb-1">Bookings</h1>
@if (Model.Workspace is not null)
{
    <p class="text-muted mb-4">@Model.Workspace.Current.Name · today and coming up</p>
}

@if (Model.Workspace is null)
{
    <div class="card p-4 text-center text-muted">You are not assigned to a restaurant yet.</div>
}
else if (Model.Bookings.TotalCount == 0)
{
    <p class="text-muted">No bookings today or coming up at this location yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle bg-white shadow-sm">
            <thead>
                <tr>
                    <th scope="col">When</th>
                    <th scope="col">Guest</th>
                    <th scope="col">Table</th>
                    <th scope="col">Party</th>
                    <th scope="col">Status</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings.Items)
                {
                    <tr>
                        <td>@booking.StartsAt.ToString("ddd dd MMM") @booking.StartsAt.ToString("HH:mm")</td>
                        <td>
                            <div class="fw-semibold">@booking.CustomerName</div>
                            <div class="small text-muted">@PhoneDisplay.Show(booking.CustomerCountryCode, booking.CustomerPhone)</div>
                            @if (!string.IsNullOrWhiteSpace(booking.SpecialRequests))
                            {
                                <div class="small fst-italic">@booking.SpecialRequests</div>
                            }
                        </td>
                        <td>@booking.Table?.Label</td>
                        <td>@booking.Guests</td>
                        <td><span class="badge text-bg-light border">@booking.Status</span></td>
                        <td class="text-end">
                            <div class="d-flex flex-wrap gap-1 justify-content-end">
                                @if (booking.Status == DineBook.Domain.Enums.ReservationStatus.Confirmed)
                                {
                                    <form method="post" asp-page-handler="Seat" data-submit-once>
                                        <input type="hidden" name="reservationId" value="@booking.Id" />
                                        <input type="hidden" name="Query.Page" value="@Model.Query.Page" />
                                        <input type="hidden" name="Query.PageSize" value="@Model.Query.PageSize" />
                                        <button class="btn btn-sm btn-brand">Seat</button>
                                    </form>
                                    <form method="post" asp-page-handler="NoShow" data-submit-once>
                                        <input type="hidden" name="reservationId" value="@booking.Id" />
                                        <input type="hidden" name="Query.Page" value="@Model.Query.Page" />
                                        <input type="hidden" name="Query.PageSize" value="@Model.Query.PageSize" />
                                        <button class="btn btn-sm btn-outline-danger">No-show</button>
                                    </form>
                                }
                                @if (booking.Status == DineBook.Domain.Enums.ReservationStatus.Seated)
                                {
                                    <form method="post" asp-page-handler="Complete" data-submit-once>
                                        <input type="hidden" name="reservationId" value="@booking.Id" />
                                        <input type="hidden" name="Query.Page" value="@Model.Query.Page" />
                                        <input type="hidden" name="Query.PageSize" value="@Model.Query.PageSize" />
                                        <button class="btn btn-sm btn-outline-success">Complete</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Bookings" />
}
