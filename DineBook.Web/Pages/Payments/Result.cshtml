@page "/Payment/Result"
@model ResultModel
@{
    ViewData["Title"] = "Payment status";

    var (badge, bannerClass, headline, detail) = Model.CurrentOrder.Status switch
    {
        PaymentStatus.Paid => ("text-bg-success", "status-banner-success", "Payment received",
            "Thank you. Your order is confirmed."),
        PaymentStatus.Refunded => ("text-bg-secondary", "status-banner-muted", "Payment refunded",
            "The refund has been issued. Banks can take several days to show it on your statement."),
        PaymentStatus.Failed => ("text-bg-danger", "status-banner-danger", "Payment didn't go through",
            "The payment wasn't completed, so your booking hasn't changed. You can try again from your booking."),
        _ => ("text-bg-warning", "status-banner-warning", "Waiting for confirmation",
            "We haven't heard back from the payment provider yet. This usually takes a minute. Use Check again to refresh.")
    };
}

<div class="page-hero mb-4">
    <h1 class="h2 mb-1">Payment status</h1>
    <p class="text-muted mb-0">Here is what happened to your payment.</p>
</div>

<div class="status-banner @bannerClass mb-4" role="status" aria-live="polite" style="max-width: 32rem;">
    <span class="badge @badge mb-2">@Model.CurrentOrder.Status</span>
    <h2 class="h5 mb-1">@headline</h2>
    <p class="mb-0">@detail</p>
</div>

<div class="card shadow-sm" style="max-width: 32rem;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-5">Order reference</dt>
            <dd class="col-7"><code>@Model.CurrentOrder.GatewayOrderId</code></dd>

            <dt class="col-5">Amount</dt>
            <dd class="col-7">@Money.Inr(Model.CurrentOrder.Amount.Amount)</dd>
        </dl>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mt-4">
    @if (Model.CurrentOrder.Status == PaymentStatus.Pending)
    {
        <a asp-page="/Payments/Result" asp-route-order_id="@Model.Query.OrderId" class="btn btn-brand">Check again</a>
    }
    @if (!string.IsNullOrEmpty(Model.RestaurantSlug))
    {
        <a asp-page="/Reservations/Details" asp-route-slug="@Model.RestaurantSlug" asp-route-locationSlug="@Model.LocationSlug" asp-route-code="@Model.ReservationCode" class="btn btn-outline-primary">Back to your booking</a>
    }
</div>
