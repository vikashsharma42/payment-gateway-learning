@page "{id:long}"
@model CheckoutModel
@{
    ViewData["Title"] = "Pay your bill";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-page="/Bookings/Index">My bookings</a></li>
        <li class="breadcrumb-item"><a asp-page="/Reservations/Details" asp-route-code="@Model.ReservationCode">@Model.RestaurantName</a></li>
        <li class="breadcrumb-item active" aria-current="page">Pay</li>
    </ol>
</nav>

<h1 class="h2 mb-4">Pay your bill</h1>

<div class="row g-4">
    <aside class="col-lg-5 order-lg-2">
        <div class="card shadow-sm summary-sticky">
            <div class="card-body">
                <h2 class="h5">@Model.RestaurantName</h2>
                <p class="text-muted small mb-3">Booking <code>@Model.ReservationCode</code></p>

                <ul class="list-unstyled mb-0">
                    @foreach (var line in Model.Order.Items)
                    {
                        <li class="d-flex align-items-center gap-3 py-2 border-bottom">
                            @if (!string.IsNullOrEmpty(line.ImageUrl))
                            {
                                <img class="dish-thumb" src="@line.ImageUrl" alt="" loading="lazy" width="48" height="48" />
                            }
                            else
                            {
                                <span class="dish-thumb dish-thumb--empty" aria-hidden="true">🍽️</span>
                            }
                            <span class="flex-grow-1">
                                @line.ItemName
                                <span class="d-block small text-muted">@line.Quantity × @Money.Inr(line.UnitPrice)</span>
                            </span>
                            <span class="fw-semibold">@Money.Inr(line.LineTotal())</span>
                        </li>
                    }
                </ul>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span>Total</span>
                    <strong class="price">@Money.Inr(Model.Order.Total())</strong>
                </div>

                <ul class="trust-list">
                    <li>Payment handled by Cashfree</li>
                    <li>We never see or store card details</li>
                </ul>
            </div>
        </div>
    </aside>

    <section class="col-lg-7 order-lg-1" aria-labelledby="checkout-heading">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                @if (Model.Pending is not null)
                {
                    <h2 id="checkout-heading" class="h5">Ready to pay</h2>
                    <p class="text-muted small mb-3">Order reference <code>@Model.Pending.OrderId</code></p>

                    <button id="payBtn" type="button" class="btn btn-success btn-lg w-100"
                            data-session="@Model.Pending.SessionId"
                            data-mode="@Model.CashfreeMode">
                        Pay @Money.Inr(Model.Pending.Amount)
                    </button>

                    <p id="payError" class="text-danger small mt-2 mb-0" role="alert"></p>
                    <p class="small text-muted mt-3 mb-0">You will be taken to a secure payment page.</p>
                }
                else
                {
                    <h2 id="checkout-heading" class="h5">Confirm payment</h2>
                    <p class="text-muted small mb-4">
                        Receipt will be sent to <strong>@Model.Booking.CustomerEmail</strong>.
                    </p>

                    <form method="post" data-submit-once>
                        <input type="hidden" asp-for="IdempotencyKey" />

                        <button type="submit" class="btn btn-brand btn-lg w-100">
                            Pay @Money.Inr(Model.Order.Total())
                        </button>
                    </form>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://sdk.cashfree.com/js/v3/cashfree.js" defer></script>
    <script src="~/js/checkout.js" asp-append-version="true" defer></script>
}
