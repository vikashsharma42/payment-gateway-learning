@page "/"
@model DirectoryModel
@{
    ViewData["Title"] = "Find your restaurant";
}

<section class="page-hero text-center py-5 px-3 mb-4" aria-labelledby="directory-title">
    <p class="error-code mb-2" aria-hidden="true">404</p>
    <h1 id="directory-title" class="h3 mb-2">We couldn't find a restaurant at this address</h1>
    <p class="text-muted mx-auto mb-0" style="max-width: 34rem;">
        Each restaurant on DineBook has its own address, for example <code>/spice-route/main</code>.
        Open the link your restaurant shared with you.
    </p>
</section>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <span class="step-number" aria-hidden="true">1</span>
                <h2 class="h6 mt-3 mb-1">Use the restaurant's link</h2>
                <p class="text-muted small mb-0">Ask the restaurant for their DineBook link, or check the QR code on their table.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <span class="step-number" aria-hidden="true">2</span>
                <h2 class="h6 mt-3 mb-1">Choose your location</h2>
                <p class="text-muted small mb-0">Some restaurants have more than one location. Pick the one you are visiting.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <span class="step-number" aria-hidden="true">3</span>
                <h2 class="h6 mt-3 mb-1">Browse, then sign in to book</h2>
                <p class="text-muted small mb-0">Menus are open to everyone. Sign in when you are ready to book a table or order food.</p>
            </div>
        </div>
    </div>
</div>
