<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<!-- Suppress NuGet package vulnerability warnings -->
		<NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
	</PropertyGroup>

  <ItemGroup>
    <!-- IHttpContextAccessor and WebEncoders, used by the JWT sign-in manager -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DineBook.Common\DineBook.Common.csproj" />
    <ProjectReference Include="..\DineBook.Domain\DineBook.Domain.csproj" />
    <ProjectReference Include="..\DineBook.Infrastructure\DineBook.Infrastructure.csproj" />
    <ProjectReference Include="..\DineBook.Payments\DineBook.Payments.csproj" />
    <ProjectReference Include="..\DineBook.Email\DineBook.Email.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <!-- JWT sign-in (JwtSecurityTokenHandler) -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

</Project>
