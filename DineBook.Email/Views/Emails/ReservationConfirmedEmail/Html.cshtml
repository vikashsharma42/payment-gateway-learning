@model ReservationConfirmedEmailModel
@{
    Layout = "/Views/Shared/_EmailLayout.cshtml";
    ViewData["Title"] = "Table booked";
}
<h1 style="margin:0 0 12px 0;font-size:22px;">Your table is booked</h1>
<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#334155;">Hi @Model.CustomerName,</p>
<p style="margin:0 0 20px 0;font-size:15px;line-height:1.6;color:#334155;">Thanks for booking with us. Here are your details.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;">
    <tr>
        <td style="padding:14px 16px;font-size:14px;color:#64748b;">Booking code</td>
        <td align="right" style="padding:14px 16px;font-size:14px;font-weight:bold;">@Model.ReservationCode</td>
    </tr>
    <tr>
        <td style="padding:14px 16px;font-size:14px;color:#64748b;border-top:1px solid #e2e8f0;">Restaurant</td>
        <td align="right" style="padding:14px 16px;font-size:14px;font-weight:bold;border-top:1px solid #e2e8f0;">@Model.RestaurantName</td>
    </tr>
    <tr>
        <td style="padding:14px 16px;font-size:14px;color:#64748b;border-top:1px solid #e2e8f0;">When</td>
        <td align="right" style="padding:14px 16px;font-size:14px;font-weight:bold;border-top:1px solid #e2e8f0;">@Model.When</td>
    </tr>
    <tr>
        <td style="padding:14px 16px;font-size:14px;color:#64748b;border-top:1px solid #e2e8f0;">Guests</td>
        <td align="right" style="padding:14px 16px;font-size:14px;font-weight:bold;border-top:1px solid #e2e8f0;">@Model.Guests</td>
    </tr>
</table>

<p style="margin:20px 0 0 0;font-size:15px;line-height:1.6;color:#334155;">To cancel, use your booking code and the phone number you gave when you booked. Please arrive on time, as we may release the table after 15 minutes.</p>
