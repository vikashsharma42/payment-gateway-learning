@model RefundIssuedEmailModel
@{
    Layout = "/Views/Shared/_EmailLayout.cshtml";
    ViewData["Title"] = "Refund issued";
}
<h1 style="margin:0 0 12px 0;font-size:22px;">Your refund has been issued</h1>
<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#334155;">Hi there,</p>
<p style="margin:0 0 20px 0;font-size:15px;line-height:1.6;color:#334155;">We have issued a refund for your order. It usually reaches your account within 5 to 7 working days, depending on your bank.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;">
    <tr>
        <td style="padding:14px 16px;font-size:14px;color:#64748b;">Order ID</td>
        <td align="right" style="padding:14px 16px;font-size:14px;font-weight:bold;">@Model.OrderReference</td>
    </tr>
    <tr>
        <td style="padding:14px 16px;font-size:14px;color:#64748b;border-top:1px solid #e2e8f0;">Refund amount</td>
        <td align="right" style="padding:14px 16px;font-size:14px;font-weight:bold;border-top:1px solid #e2e8f0;">@Model.Amount</td>
    </tr>
</table>

<p style="margin:20px 0 0 0;font-size:15px;line-height:1.6;color:#334155;">If the amount has not appeared after 7 working days, contact Stupro support and quote your order ID.</p>