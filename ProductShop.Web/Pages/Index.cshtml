@page
@model IndexModel
@{
    ViewData["Title"] = "Products";
}

<section class="hero mb-4 mb-md-5">
    <h1 class="display-6">Shop our products</h1>
    <p class="lead mb-0">Clear prices in ₹ and a secure checkout powered by Cashfree.</p>
</section>

@if (Model.Products.Count == 0)
{
    <div class="card p-4 text-center text-muted">
        No products are available right now. Please check back soon.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        @foreach (var product in Model.Products)
        {
            <div class="col">
                <article class="card product-card h-100 shadow-sm">
                    <div class="product-media">
                        <img class="product-img" src="@product.ImageUrl" alt="@product.Name"
                             width="600" height="400" loading="lazy" decoding="async" />
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h2 class="h6 product-name mb-1">@product.Name</h2>
                        <p class="small text-muted flex-grow-1 mb-3">@product.Description</p>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="price">@Money.Inr(product.Price)</span>
                            <a class="btn btn-brand btn-sm" asp-page="/Checkout" asp-route-id="@product.Id">
                                Buy now<span class="visually-hidden">: @product.Name</span>
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
