@page "{id:int}"
@model CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-page="/Index">Products</a></li>
        <li class="breadcrumb-item active" aria-current="page">Checkout</li>
    </ol>
</nav>

<h1 class="h2 mb-4">Checkout</h1>

<div class="row g-4">
    <aside class="col-lg-5 order-lg-2">
        <div class="card shadow-sm summary-sticky">
            <img class="card-img-top product-img" src="@Model.Product.ImageUrl" alt="@Model.Product.Name"
                 width="600" height="400" />
            <div class="card-body">
                <h2 class="h5">@Model.Product.Name</h2>
                <p class="text-muted small mb-0">@Model.Product.Description</p>

                <div class="d-flex justify-content-between align-items-center border-top mt-3 pt-3">
                    <span>Total</span>
                    <strong class="price">@Money.Inr(Model.Product.Price)</strong>
                </div>

                <ul class="trust-list">
                    <li>Payment handled by Cashfree</li>
                    <li>We never see or store card details</li>
                    <li>Protected against bots by Cloudflare Turnstile</li>
                </ul>
            </div>
        </div>
    </aside>

    <section class="col-lg-7 order-lg-1" aria-labelledby="checkout-heading">
        @if (Model.Pending is not null)
        {
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 id="checkout-heading" class="h5">Ready to pay</h2>
                    <p class="text-muted small mb-1">Order reference</p>
                    <p><code>@Model.Pending.OrderId</code></p>

                    <button id="payBtn" type="button" class="btn btn-success btn-lg w-100"
                            data-session="@Model.Pending.SessionId"
                            data-mode="@Model.CashfreeMode">
                        Pay @Money.Inr(Model.Pending.Amount)
                    </button>

                    <p id="payError" class="text-danger small mt-2 mb-0" role="alert"></p>
                    <p class="small text-muted mt-3 mb-0">You will be taken to a secure payment page.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 id="checkout-heading" class="h5 mb-3">Your details</h2>

                    <form method="post" data-submit-once>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <input type="hidden" asp-for="IdempotencyKey" />

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" class="form-control form-control-lg"
                                   placeholder="you@example.com" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" type="tel" class="form-control form-control-lg"
                                   placeholder="+91 9999999999" autocomplete="tel" inputmode="tel" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="cf-turnstile mb-3" data-sitekey="@Model.TurnstileSiteKey"></div>

                        <button type="submit" class="btn btn-brand btn-lg w-100">Continue to payment</button>
                    </form>
                </div>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script src="https://sdk.cashfree.com/js/v3/cashfree.js" defer></script>
    <script src="~/js/checkout.js" asp-append-version="true" defer></script>
}
