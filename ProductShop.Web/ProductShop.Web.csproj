<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<!-- Suppress NuGet package vulnerability warnings -->
		<NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <!-- Same id as ProductShop.API, so both projects share the Cashfree secrets -->
    <UserSecretsId>6f1c2b7e-3d4a-4e8f-9b2a-7c5d1e0f8a31</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProductShop.Application\ProductShop.Application.csproj" />
    <ProjectReference Include="..\ProductShop.Infrastructure\ProductShop.Infrastructure.csproj" />
  </ItemGroup>

</Project>
