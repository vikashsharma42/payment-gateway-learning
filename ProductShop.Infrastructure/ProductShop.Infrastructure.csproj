<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<!-- Suppress NuGet package vulnerability warnings -->
		<NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />	  
		<!-- SQL Server / Azure SQL -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProductShop.Domain\ProductShop.Domain.csproj" />
  </ItemGroup>

</Project>
